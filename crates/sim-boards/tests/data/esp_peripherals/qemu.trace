# QEMU emulator version 9.2.2 (esp_develop_9.2.2_20260417)
# UART0, UART1, MMIO и PC до второго чтения CRC

[echo]
FIXTURE cold
FIXTURE gpio out=0 in=0
FIXTURE gpio out=1 in=0
FIXTURE gpio out=0 in=0
FIXTURE uart tx=4 rx=4 55 a6 00 ff match
FIXTURE ledc begin hz=4000 duty=256,768
FIXTURE error ledc duty ESP_ERR_INVALID_ARG
FIXTURE i2c begin hz=100000 address=0x50
FIXTURE i2c probe 0x50 ESP_ERR_TIMEOUT
FIXTURE i2c probe 0x51 ESP_ERR_TIMEOUT
FIXTURE sleep timer us=2000000 failures=0xb
UART1 host TX=55 a6 00 ff RX=55 a6 00 ff
GPIO write 0x6000400c 0x8 4
GPIO write 0x60004024 0x8 4
GPIO write 0x6000400c 0x8 4
GPIO write 0x60004008 0x8 4
GPIO write 0x6000400c 0x8 4
UART1 CLKDIV 0x30015b divisor_x16=5555
LEDC timer 0x600190a0 0x9c40 0xa 0x2000000 0x0 0x800000 0x0 [esp32c3.iomem]
LEDC duty 0x60019008 0x1000 [esp32c3.iomem]
I2C FIFO 0x6001301c 0xa0 0xa2 [esp32c3.iomem]
RTC timer low 0x60008004 0x42659 [misc.esp32c3.rtc_cntl]
RTC timer high 0x60008008 0x0 0x10000 [misc.esp32c3.rtc_cntl]
RTC FASTMEM CRC 0x600c0048 write=0x7ff00000 write=0x7ff00100 read=0x0 read=0x0
PC 0x4201794c rtc_deep_sleep_start: beqz между двумя чтениями CRC

[corrupt]
FIXTURE cold
FIXTURE gpio out=0 in=0
FIXTURE gpio out=1 in=0
FIXTURE gpio out=0 in=0
FIXTURE uart tx=4 rx=4 55 a6 00 fe fail
FIXTURE ledc begin hz=4000 duty=256,768
FIXTURE error ledc duty ESP_ERR_INVALID_ARG
FIXTURE i2c begin hz=100000 address=0x50
FIXTURE i2c probe 0x50 ESP_ERR_TIMEOUT
FIXTURE i2c probe 0x51 ESP_ERR_TIMEOUT
FIXTURE sleep timer us=2000000 failures=0xf
UART1 host TX=55 a6 00 fe RX=55 a6 00 ff
GPIO write 0x6000400c 0x8 4
GPIO write 0x60004024 0x8 4
GPIO write 0x6000400c 0x8 4
GPIO write 0x60004008 0x8 4
GPIO write 0x6000400c 0x8 4
UART1 CLKDIV 0x30015b divisor_x16=5555
LEDC timer 0x600190a0 0x9c40 0xa 0x2000000 0x0 0x800000 0x0 [esp32c3.iomem]
LEDC duty 0x60019008 0x1000 [esp32c3.iomem]
I2C FIFO 0x6001301c 0xa0 0xa2 [esp32c3.iomem]
RTC timer low 0x60008004 0x42659 [misc.esp32c3.rtc_cntl]
RTC timer high 0x60008008 0x0 0x10000 [misc.esp32c3.rtc_cntl]
RTC FASTMEM CRC 0x600c0048 write=0x7ff00000 write=0x7ff00100 read=0x0 read=0x0
PC 0x4201794c rtc_deep_sleep_start: beqz между двумя чтениями CRC

[silent]
FIXTURE cold
FIXTURE gpio out=0 in=0
FIXTURE gpio out=1 in=0
FIXTURE gpio out=0 in=0
FIXTURE uart tx=4 rx=0 fail
FIXTURE ledc begin hz=4000 duty=256,768
FIXTURE error ledc duty ESP_ERR_INVALID_ARG
FIXTURE i2c begin hz=100000 address=0x50
FIXTURE i2c probe 0x50 ESP_ERR_TIMEOUT
FIXTURE i2c probe 0x51 ESP_ERR_TIMEOUT
FIXTURE sleep timer us=2000000 failures=0xf
UART1 host TX=(пусто) RX=55 a6 00 ff
GPIO write 0x6000400c 0x8 4
GPIO write 0x60004024 0x8 4
GPIO write 0x6000400c 0x8 4
GPIO write 0x60004008 0x8 4
GPIO write 0x6000400c 0x8 4
UART1 CLKDIV 0x30015b divisor_x16=5555
LEDC timer 0x600190a0 0x9c40 0xa 0x2000000 0x0 0x800000 0x0 [esp32c3.iomem]
LEDC duty 0x60019008 0x1000 [esp32c3.iomem]
I2C FIFO 0x6001301c 0xa0 0xa2 [esp32c3.iomem]
RTC timer low 0x60008004 0x42659 [misc.esp32c3.rtc_cntl]
RTC timer high 0x60008008 0x0 0x10000 [misc.esp32c3.rtc_cntl]
RTC FASTMEM CRC 0x600c0048 write=0x7ff00000 write=0x7ff00100 read=0x0 read=0x0
PC 0x4201794c rtc_deep_sleep_start: beqz между двумя чтениями CRC
