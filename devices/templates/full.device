# Проект мастерской устройств
# Формат sim-device 2

[device]
name = Экзоскелет рук и ног
template = full
mount = torso

[use]
ambient_c = 25
cycles = 100000
long_wear = false
hours_per_day = 2

[electronics]
board = rp2040
driver = 
regulator = lm2596-adj
cell = Molicel INR21700-P42A
series = 6
parallel = 1
fuse_a = 10
wire_mm2 = 1.5
wire_m = 0.5
bms = false
firmware = 
board_regulated = true

[design]
sex = female
strength_pct = 5

[link]
name = Рама спины
parent = none
offset_mm = 0 0 0
direction = down
length_mm = 420
section = rect 12 30
material = al6061-t6
print = none
hole_mm = 0
end_mass_kg = 0
near_body = torso
contact_lever_mm = 420
joint = fixed
axis = y
min_deg = 0
max_deg = 0
actuator = 
speed_limit_dps = 0
torque_limit_nm = 0
pinch_gap_mm = 0
guarded = false

